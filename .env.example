# Google OAuth 2.0 Web Client ID (public ID; not the client secret)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com

# Exact single account permitted to open ET Group Admin
ADMIN_EMAIL=wajahat.et512@gmail.com

# Generate a random value of at least 32 bytes. Keep it only in Vercel Environment Variables.
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES

# Exact HTTPS origin of the deployed website, with no trailing slash or path.
APP_ORIGIN=https://YOUR-DEPLOYMENT.vercel.app
